parameters:
	level: 8
	phpVersion: 80400
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	paths:
		- src
		- ProcessWireConsole.module.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Defensive nullsafe guards when ProcessWire Config/Paths properties are uninitialized in isolated unit tests
		-
			identifier: nullsafe.neverNull
