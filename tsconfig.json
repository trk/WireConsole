{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["resources/ts/**/*.ts", "resources/ts/**/*.tsx"]
}
